# Supabase — required for persistence (stub mode works without these)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google OAuth (configure in Supabase Dashboard → Authentication → Providers → Google):
# Set Client ID and Client Secret in the dashboard — not in this repo.
# Redirect URL must include: https://greenlit-six.vercel.app/** and http://localhost:5173/**

# Set to "true" to use deterministic stub instead of Edge Function LLM calls
VITE_LLM_STUB_MODE=true

# Comma-separated allowlist for the /admin/shops UI gate (UX-only — real access
# control is the admin_emails table + is_admin() RLS policies, see 0005 migration)
VITE_ADMIN_EMAILS=yashbolishetti@gmail.com

# Sales contact shown on /for-shops and the shop dashboard Team tab
VITE_SALES_EMAIL=hello@greenlit.co

# Edge Function secrets (set via `supabase secrets set`, not in browser —
# for local dev, put real values in supabase/functions/.env instead, which
# is git-ignored):

# ---- LLM engine (added 2026-08-03) ----
# Provider selection — default is anthropic; set to 'openai' per-role to roll back
# INTERVIEWER_PROVIDER=anthropic
# DIAGNOSTICIAN_PROVIDER=anthropic

# Anthropic (required when a provider above is 'anthropic', the default)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages

# Model IDs (swappable at deploy time, no code change)
# INTERVIEWER_MODEL_ID=claude-haiku-4-5
# DIAGNOSTICIAN_MODEL_ID=claude-sonnet-5

# Kill switch: set to 'stub' to bypass the LLM entirely — the client falls
# back to the deterministic stub with no other change needed.
# DIAGNOSIS_ENGINE=llm

# OpenAI rollback path (kept, not removed) — used when *_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# Later fine-tune swap:
# DIAGNOSTICIAN_MODEL_ID=ft:gpt-4o-2024-07:greenlit:diagnostician-v1:abc123

# Also set on the Edge Function so llm_traces.prompt_version is populated:
# INTERVIEWER_PROMPT_SHA=<git sha of src/lib/ai/prompts/interviewer.md>
# DIAGNOSTICIAN_PROMPT_SHA=<git sha of src/lib/ai/prompts/diagnostician.md>

# Build-time provenance stamps (populated by scripts/inject-build-shas.sh in CI/Vercel;
# fall back to "dev" locally so intake creation never fails on missing env vars)
VITE_INTERVIEWER_PROMPT_SHA=
VITE_DIAGNOSTICIAN_PROMPT_SHA=
VITE_UI_RULES_SHA=
VITE_APP_BUILD_SHA=
